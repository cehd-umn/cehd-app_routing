{% if data.events|length > 0 %}
    <dl class="events">
    {% for event in data.events %}
        {% if loop.index0 < data.limit %}
            <dt class="date">
                {{ event.dayOfWeek }},
                {{ event.fullMonth }}
                {{ event.day }}, {{ event.year }}
                {% if event.startTime and event.endTime %}
                    | {{ event.startTime }} - {{ event.endTime }}
                {% endif %}
            </dt>
            <dd class="event-title">
                <p class="event">
                    <a class="event-link" data-event-id="{{ event.id }}" href="/events/{{ event.id }}/">{{ event.title }}</a>
                </p>
                {% if event.shortDescription %}
                    <div class="description">
                        {{ event.shortDescription|strip_style_attributes|safe }}
                    </div>
                {% endif %}
            </dd>
        {% endif %}
    {% endfor %}
    </dl>
{% else %}
    <p>There are no upcoming events.</p>
{% endif %}

